# La Coquette — Environment Variables
# Copy this file to .env (local dev) and add the same keys in Vercel Project Settings → Environment Variables

# PostgreSQL connection string (Neon, Supabase, or any Postgres URI)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Admin login credentials
ADMIN_EMAIL=admin@lacoquette.dz
ADMIN_PASSWORD=change-me

# Telegram Bot notifications (order alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
